# Optional. When set, Blindspot embeds traces and pre-grades them with Azure OpenAI
# instead of the offline hashing embedder and the simulated judge.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# Server
PORT=4040
BLINDSPOT_DB=./data/blindspot.sqlite
