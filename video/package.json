{
  "name": "@blindspot/video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Demo out/blindspot-demo.mp4 --codec=h264 --crf=16",
    "render:silent": "remotion render src/index.ts DemoSilent out/blindspot-demo-silent.mp4 --codec=h264 --crf=16",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@blindspot/web": "*",
    "@react-three/fiber": "^9.0.0",
    "@remotion/cli": "4.0.533",
    "@remotion/google-fonts": "^4.0.533",
    "@remotion/three": "^4.0.533",
    "@types/three": "^0.170.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.533",
    "three": "^0.170.0",
    "use-sync-external-store": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4"
  }
