{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "DOM",
      "ES2022"
    ],
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@web/*": [
        "../apps/web/src/*"
      ]
    }
  },
  "include": [
    "src",
    "remotion.config.ts"
  ]
}